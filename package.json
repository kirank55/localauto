{
  "name": "localauto",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Fills application forms on your device from your profile and answers you confirm.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirank55/localauto.git"
  },
  "bugs": {
    "url": "https://github.com/kirank55/localauto/issues"
  },
  "homepage": "https://github.com/kirank55/localauto#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs entrypoints src/packages",
    "check": "npm run typecheck && npm run lint:boundaries && npm run test",
    "demo": "node demo/serve.mjs",
    "try": "node e2e/try.mjs",
    "icons": "node scripts/render-icons.mjs",
    "test:e2e": "npm run build && node e2e/smoke.mjs",
    "store-assets": "npm run build && node scripts/store-assets.mjs",
    "product-hunt": "npm run build && node scripts/product-hunt.mjs"
  },
  "dependencies": {
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
