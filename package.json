{
  "name": "localauto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs entrypoints src/packages",
    "check": "npm run typecheck && npm run lint:boundaries && npm run test",
    "demo": "node demo/serve.mjs",
    "try": "node e2e/try.mjs",
    "icons": "node scripts/render-icons.mjs",
    "test:e2e": "npm run build && node e2e/smoke.mjs"
  },
  "dependencies": {
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
